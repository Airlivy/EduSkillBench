{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qwen-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen Custom",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "[CONFIGURE_LOCALLY]"
      },
      "models": {
        "qwen3.7-plus": {
          "name": "Qwen3.7-Plus"
        }
      }
    }
  }
}
